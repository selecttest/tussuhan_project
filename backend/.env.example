# 通用基底設定（可選）
# 後端啟動時會先讀 .env，再讀 .env.{APP_ENV} 作覆寫。
# 建議：
# - 開發：APP_ENV=development，填 backend/.env.development
# - 正式：APP_ENV=production，填 backend/.env.production

# APP_ENV 可由 shell 或 service 設定；沒設時預設 development
# APP_ENV=development

# 若要共用設定可放這裡；沒共用可留空。
# GOOGLE_SHEETS_ID=
# GOOGLE_CREDENTIALS_PATH=

# CORS_ORIGIN 可用逗號放多個來源（例：本機 + ngrok）
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.ngrok-free.dev
# 重要：請複製此檔為「.env」（backend 目錄下）。程式只會讀取 backend/.env，只改 .env.example 不會生效。
# 修改 .env 後請重啟 uvicorn。診斷：瀏覽器開 http://127.0.0.1:8000/health 查看 hint、sheetsError。
#
# GOOGLE_SHEETS_ID 可貼完整網址，程式會自動抽出 ID。
GOOGLE_SHEETS_ID=

# Service Account 金鑰（建議絕對路徑）
GOOGLE_CREDENTIALS_PATH=C:\Users\2510094\Desktop\tussuhan_project\backend\credentials.json
# 在 backend 目錄執行 uvicorn 時也可： GOOGLE_CREDENTIALS_PATH=credentials.json

# 要連真實試算表請勿設為 true
# DEMO_MODE=false

# 瀏覽器「網頁來源」須在此列白名單，否則會 CORS 擋下。多個請用英文逗號分隔、勿加空白（或整行改 *）。
# 例：本機 Vite + ngrok 前端
# CORS_ORIGIN=http://localhost:3000,https://你的前端.ngrok-free.dev
CORS_ORIGIN=http://localhost:3000

# LINE_BOT 可選
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
