APP_ENV=production

# 正式環境（GCP）：填正式試算表與憑證路徑
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_PATH=/home/your_user/line-bot-accounting/backend/credentials.json

DEMO_MODE=false

# 正式前端來源白名單（可逗號分隔）
# 例如：https://your-domain.com,https://your-frontend.ngrok-free.dev
CORS_ORIGIN=https://your-domain.com

# 正式 LINE Bot
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# EXPENSE_SHEET_NAME=支出紀錄
